<div class="card-testimonial {{ classes|join(' ') }}">
  <div class="card-testimonial-header">
    <div class="card-testimonial-info">
      <div class="card-testimonial-subject">
        {{ heading }}
      </div>
      <div class="card-testimonial-date">
        {{ date }}
      </div>
    </div>

    <div class="stars" data-rating="{{ rating }}"></div>
  </div>
  <div class="card-testimonial-text">
    {{ quote|raw }}
  </div>
  <div class="card-testimonial-item-footer"> 
    <span>{{ customer_name }}</span>
  </div>
</div>
