<div class="wrap tabs-component">
  <div class="heading {{ textAlignment }}">
    <h2>{{ title }}</h2>

    {% if content is not empty %}
      {{ content|raw }}
    {% endif %}
  </div>
  

  <ul class="tabs" role="tablist">
    <li>
      <button 
        class="tab-btn active"
        role="tab" 
        aria-selected="" 
        data-tab="All">
          {{ "All" }}
      </button>
    </li>
    {% for tab in tabItem %}
      {% if tab.views_block %}
        <li>
          <button 
            class="tab-btn" 
            role="tab" 
            {# aria-selected="{{ loop.first ? 'true' : 'false' }}"  #}
            aria-selected="false" 
            data-tab="{{ tab.heading_slug }}">
              {{ tab.heading }}
          </button>
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  {% for tab in tabItem %}
    <div class="panel active" id="{{ tab.heading_slug }}">
      {{ tab.views_block }}
    </div>
  {% endfor %}
  </div>
