{% set banner_items = '' %}

{% for item in bannerItems %}
  {% set banner %}
    <div class="swiper-slide">
      <div class="main-banner-content">
        <div class="img-container">

          <div class="banner-desktop">
            {% if item.field_image is not empty %}
              <img
                class="banner-image"
                src="{{ item.field_image.image_uri }}"
                alt="{{ item.field_image.image_alt }}"
                title="{{ item.field_image.image_alt }}">
            {% endif %}

            {% if item.field_desktop_video_banner is not empty %}
              <video
                class="banner-video"
                playsinline
                autoplay="autoplay"
                loop="loop"
                muted="muted">
                <source src="{{ item.field_desktop_video_banner }}" type="video/mp4">
              </video>
            {% endif %}
          </div>

          <div class="banner-mobile">
            {% if item.field_mobile_banner is not empty %}
              <img
                class="banner-image"
                src="{{ item.field_mobile_banner.image_uri }}"
                alt="{{ item.field_mobile_banner.image_alt }}"
                title="{{ item.field_mobile_banner.image_alt }}">
            {% endif %}
            {% if item.field_mobile_video_banner is not empty %}
              <video
                class="banner-video"
                playsinline
                autoplay="autoplay"
                loop="loop"
                muted="muted">
                <source src="{{ item.field_mobile_video_banner }}" type="video/mp4">
              </video>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endset %}

  {% set banner_items = banner_items ~ banner %}
{% endfor %}

{# <Swiper> #}
{% embed 'solaire_sec:swiper_banner_slider' with {
  cardItem: banner_items
} %}

  {% block pagination %}
  {% endblock %}

  {# {% block navigation %}
  {% endblock %} #}

  {% block scrollbar %}
  {% endblock %}

{% endembed %}
{# </Swiper> #}
